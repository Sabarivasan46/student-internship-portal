{
  "name": "internship-portal-server",
  "version": "1.0.0",
  "description": "Student Internship Portal API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "server": "nodemon app.js",
    "client": "npm --prefix client run dev",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "setup": "npm install && npm --prefix client install"
  },
  "keywords": [
    "internship-portal",
    "mern",
    "express",
    "react",
    "mongodb"
  ],
  "author": "Shankar-Prakasam",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
